# Single backend env file for API, Identity, Worker, and Prisma (local development).
# Copy to backend/.env — never commit backend/.env

NODE_ENV=development

# --- Shared infrastructure (docker compose) ---
REDIS_URL=redis://localhost:6379

# --- Identity PostgreSQL (port 5433) ---
IDENTITY_DATABASE_URL=postgresql://identity_app:identity_dev@localhost:5433/dropclub_identity?schema=public
IDENTITY_DATABASE_DIRECT_URL=postgresql://identity_migrator:identity_migrator_dev@localhost:5433/dropclub_identity?schema=public

# --- Business PostgreSQL (port 5434) ---
BUSINESS_DATABASE_URL=postgresql://business_app:business_dev@localhost:5434/dropclub_business?schema=public
BUSINESS_DATABASE_DIRECT_URL=postgresql://business_migrator:business_migrator_dev@localhost:5434/dropclub_business?schema=public

# --- Business API (port 4000) ---
API_PORT=4000
IDENTITY_SERVICE_URL=http://localhost:4100
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
SWAGGER_ENABLED=true

# --- Identity service (port 4100) ---
IDENTITY_PORT=4100
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
SESSION_SECRET=dev-only-change-me-32-characters-min
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000
COOKIE_SECURE=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
ADMIN_SESSION_ACCESS_TTL_SECONDS=900
ADMIN_SESSION_REFRESH_TTL_SECONDS=86400

# --- Worker (port 4200) ---
WORKER_PORT=4200

# --- Service-to-service (same value in all processes that call internal identity routes) ---
INTERNAL_SERVICE_SECRET=dev-internal-shared-secret