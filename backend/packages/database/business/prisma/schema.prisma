generator client {
  provider = "prisma-client-js"
  output   = "../../generated/business"
}

datasource db {
  provider  = "postgresql"
  url       = env("BUSINESS_DATABASE_URL")
  directUrl = env("BUSINESS_DATABASE_DIRECT_URL")
}

enum OfferStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String   @id
  nameFa      String
  nameEn      String?
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  offers      Offer[]

  @@index([isActive, sortOrder])
}

model Offer {
  id               String      @id @default(uuid()) @db.Uuid
  slug             String      @unique
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title            String
  summary          String
  description      String?
  merchantName     String
  imageUrl         String?
  priceCurrent     Decimal     @db.Decimal(18, 2)
  priceReference   Decimal?    @db.Decimal(18, 2)
  currency         String      @default("IRR")
  validUntil       DateTime?
  terms            String?
  disclosureLabel  String?
  destinationUrl   String
  affiliateUrl     String?
  status           OfferStatus @default(DRAFT)
  publishedAt      DateTime?
  checkedAt        DateTime?
  createdByAdminId String?     @db.Uuid
  updatedByAdminId String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
}