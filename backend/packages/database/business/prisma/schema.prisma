generator client {
  provider = "prisma-client-js"
  output   = "../../generated/business"
}

datasource db {
  provider  = "postgresql"
  url       = env("BUSINESS_DATABASE_URL")
  directUrl = env("BUSINESS_DATABASE_DIRECT_URL")
}

enum OfferStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id             String           @id
  nameFa         String
  nameEn         String?
  description    String?
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  offers         Offer[]
  demandRequests DemandRequest[]

  @@index([isActive, sortOrder])
}

model AffiliatePartner {
  id          String   @id
  displayName String
  websiteUrl  String?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  offers      Offer[]
}

model Offer {
  id               String      @id @default(uuid()) @db.Uuid
  slug             String      @unique
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partnerId        String?
  partner          AffiliatePartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  title            String
  summary          String
  description      String?
  merchantName     String
  imageUrl         String?
  priceCurrent     Decimal     @db.Decimal(18, 2)
  priceReference   Decimal?    @db.Decimal(18, 2)
  currency         String      @default("IRR")
  validUntil       DateTime?
  terms            String?
  disclosureLabel  String?
  destinationUrl   String
  affiliateUrl     String?
  status           OfferStatus @default(DRAFT)
  publishedAt      DateTime?
  checkedAt        DateTime?
  createdByAdminId String?     @db.Uuid
  updatedByAdminId String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  outboundClicks   OutboundClick[]
  favorites        Favorite[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([partnerId])
}

enum OutboundDestinationKind {
  AFFILIATE
  DIRECT
}

model OutboundClick {
  id              String                  @id @default(uuid()) @db.Uuid
  offerId         String                  @db.Uuid
  offer           Offer                   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerSlug       String
  destinationKind OutboundDestinationKind
  redirectHost    String
  visitorHash     String?
  subjectId       String?                 @db.Uuid
  idempotencyKey  String?                 @unique
  createdAt       DateTime                @default(now())

  @@index([offerId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @db.Uuid
  offerId   String   @db.Uuid
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([subjectId, offerId])
  @@index([subjectId, createdAt(sort: Desc)])
}

enum DemandRequestStatus {
  PENDING
  REVIEWED
  CLOSED
  REJECTED
}

model DemandRequest {
  id             String              @id @default(uuid()) @db.Uuid
  subjectId      String              @db.Uuid
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedOfferId String?             @db.Uuid
  description    String
  budgetAmount   Decimal?            @db.Decimal(18, 2)
  budgetCurrency String?             @default("IRR")
  consentGivenAt DateTime
  status         DemandRequestStatus @default(PENDING)
  adminNotes     String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([subjectId, createdAt(sort: Desc)])
}