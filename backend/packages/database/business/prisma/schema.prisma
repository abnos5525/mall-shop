generator client {
  provider = "prisma-client-js"
  output   = "../../generated/business"
}

datasource db {
  provider  = "postgresql"
  url       = env("BUSINESS_DATABASE_URL")
  directUrl = env("BUSINESS_DATABASE_DIRECT_URL")
}

/// Placeholder model for Phase 1 connectivity; business domain models arrive in Phase 4.
model SchemaBootstrap {
  id        String   @id @default("bootstrap")
  updatedAt DateTime @updatedAt
}