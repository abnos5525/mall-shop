generator client {
  provider = "prisma-client-js"
  output   = "../../generated/identity"
}

datasource db {
  provider  = "postgresql"
  url       = env("IDENTITY_DATABASE_URL")
  directUrl = env("IDENTITY_DATABASE_DIRECT_URL")
}

/// Placeholder model for Phase 1 connectivity; identity domain models arrive in Phase 2.
model SchemaBootstrap {
  id        String   @id @default("bootstrap")
  updatedAt DateTime @updatedAt
}