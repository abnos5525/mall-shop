# Frontend / Next.js (Mini App) — copy to repo root `.env` or `.env.local`
# Never put bot tokens or server secrets here (NEXT_PUBLIC_* is exposed to the browser).

NEXT_PUBLIC_APP_NAME=DropClub
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_IDENTITY_BASE_URL=http://localhost:4100/api/v1
# Admin app (frontend-admin on :3001) uses the same Identity base URL.